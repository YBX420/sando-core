Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Cell Size: 5
      Color: 60; 63; 70
      Plane Cell Count: 40
      Enabled: true
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: sando
      Topic:
        Value: /sando/markers
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Enabled: true
      Value: true
  Global Options:
    Background Color: 16; 18; 22
    Fixed Frame: map
    Frame Rate: 60
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/Measure
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 40
      Pitch: 0.9
      Yaw: 0.9
      Focal Point:
        X: 9
        Y: 0
        Z: 1
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1400
