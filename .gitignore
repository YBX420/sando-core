# C++ build artifacts
cpp/build/
cpp/build_v2/
build/

# compiled capi shared lib (rebuilt by hand: g++ -O2 -shared -fPIC ... -o capi/sando_capi.so)
cpp/capi/sando_capi.so
cpp/build/sando_capi.so
cpp/capi/sando_capi.dll

# EGO-Planner capi (rebuilt by hand: g++ -O2 -shared -fPIC -Wno-narrowing ... -o capi/ego_capi.so)
ego/capi/ego_capi.so
ego/capi/ego_capi.dll

# ROS 2 / colcon (under cpp/ros2 — source is tracked, build output is not)
cpp/ros2/build/
cpp/ros2/install/
cpp/ros2/log/

# Isaac glue: python cache + run outputs (the loop writes these)
__pycache__/
*.py[cod]
isaac/isaac_flown.csv
isaac/isaac_flown.png
# Isaac IRA scene cache (contains large binary assets >100MB, not for git)
isaac/ira/

# MetaUrban demo run outputs: ignore bulk CSVs + per-seed dirs; KEEP the headline PNGs/JSON
# (out/drone_topdown.png, out/ablation.png, out/summary.json, out/ablation.json are force-added)
metaurban/out/*.csv
metaurban/out_s*/

# editor + local logs
.vscode/
*.log
metaurban/out/

# conformal pipeline: ignore the bulk harvested trajectory data (reproducible via conformal_harvest.py),
# KEEP the small calibrated artifacts (calib.json, ab_summary*.json, *.png)
out/conformal/*.npz
logs/

